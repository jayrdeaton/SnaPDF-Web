{
  "name": "snapdf-web",
  "displayName": "SnaPDF",
  "version": "1.1.6",
  "private": true,
  "description": "Save any JavaScript-rendered web page as PDF or text.",
  "author": "Jay Deaton",
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "fix": "eslint . --fix",
    "generate": "nuxt generate",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "preview": "nuxt preview",
    "release": "git push --follow-tags",
    "release:major": "npm version major && npm run release",
    "release:minor": "npm version minor && npm run release",
    "release:patch": "npm version patch && npm run release",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:watch": "NODE_OPTIONS=--no-experimental-webstorage vitest",
    "typecheck": "nuxt typecheck",
    "verify": "npm run lint && npm test && npm run typecheck && npm run build",
    "preversion": "npm ci && npm run verify"
  },
  "prettier": "@infinitetoken/eslint-config/prettier",
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "dependencies": {
    "@nuxtjs/color-mode": "^4.0.0",
    "@sparticuz/chromium": "^149.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "nuxt": "^4.4.6",
    "snapdf": "^1.0.10",
    "tailwindcss": "^4.3.0",
    "vue": "^3.5.13",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@infinitetoken/eslint-config": "^0.2.1",
    "@nuxt/test-utils": "^4.0.3",
    "@types/node": "^25.0.0",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vue/test-utils": "^2.4.10",
    "eslint": "^10.4.1",
    "happy-dom": "^20.9.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7",
    "vue-tsc": "^3.3.3"
  }
}
